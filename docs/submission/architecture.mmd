flowchart TB
    U["Operador de campo"]

    subgraph W["Entrada wearable / pré-hardware"]
        CAM["Checkpoint 2 - Câmera<br/>Meta Wearables DAT 0.9.0<br/>MockDeviceKit nesta etapa"]
        MIC["Checkpoint 2 - Microfone<br/>rota de áudio do Android<br/>SpeechRecognizer"]
        OUT["Checkpoint 3 - Áudio<br/>Android TTS<br/>rota de áudio ativa"]
    end

    subgraph A["Android físico - Kotlin - processamento local"]
        FRAME["Captura sob demanda<br/>1 frame por interação"]
        QR["ZXing<br/>QR do alvo mapeado"]
        STT["SpeechRecognizer<br/>transcrição pt-BR"]
        OPAI["Checkpoint 1 - IA operacional<br/>LocalIntentClassifier<br/>intenções restritas"]
        TARGET["TargetResolver<br/>alvo visual + ID falado"]
        SAFE["InteractionEngine<br/>confirmação obrigatória<br/>fail-closed em conflito"]
        QWEN["Checkpoint 1 - IA conversacional<br/>Qwen2.5-1.5B + llama.cpp<br/>CHAT / OUT_OF_SCOPE somente"]
        PRIV["Checkpoint 4 - Privacidade<br/>sem persistência de mídia bruta<br/>logs: estado, alvo, intenção, erro"]
        BATT["Checkpoint 5 - Bateria<br/>captura sob demanda<br/>IA operacional pequena<br/>Qwen apenas quando necessário"]
    end

    subgraph L["Rede local"]
        WS["JSON v1 + WebSocket<br/>command_id + expiração"]
    end

    subgraph R["Robô / simulação"]
        BR["Bridge ROS 2<br/>schema + confirmação + estado<br/>expiração + deduplicação"]
        NAV["Nav2<br/>target_id allowlisted -> pose"]
        TB["TurtleBot 4<br/>Gazebo"]
    end

    U -->|"olha para o alvo"| CAM
    CAM --> FRAME --> QR --> TARGET
    U -->|"fala"| MIC --> STT --> OPAI
    STT -->|"ID falado opcional"| TARGET
    OPAI -->|"SPRAY / DOCK / UNDOCK / CONFIRM / CANCEL"| SAFE
    OPAI -->|"UNKNOWN"| QWEN
    TARGET -->|"concordância ou conflito"| SAFE
    SAFE -->|"pergunta / resultado"| OUT --> U
    QWEN -->|"resposta sobre o Maestro"| OUT
    SAFE -->|"somente após confirmar"| WS --> BR --> NAV --> TB
    BR -->|"ACCEPTED / REJECTED / FAILED"| WS

    FRAME -. "descarta após uso" .-> PRIV
    STT -. "não persiste por padrão" .-> PRIV
    FRAME -. "uso pontual" .-> BATT
    OPAI -. "local e pequeno" .-> BATT
    QWEN -. "fora do caminho crítico" .-> BATT

    NOTE["Sem inferência em nuvem no caminho do MVP.<br/>Qwen não acessa Command, WebSocket ou ROS."]
    QWEN -.-> NOTE

    classDef input fill:#E9F5EC,stroke:#237A3B,color:#102418;
    classDef local fill:#F5F7F5,stroke:#43634D,color:#102418;
    classDef ai fill:#EAF1FF,stroke:#315FA8,color:#10203B;
    classDef safety fill:#FFF2CC,stroke:#9A6A00,color:#241A00;
    classDef privacy fill:#FCECEC,stroke:#A33C3C,color:#321414;
    classDef robot fill:#F2ECFF,stroke:#6644A6,color:#21163A;
    classDef note fill:#FFFFFF,stroke:#777777,color:#333333;

    class CAM,MIC,OUT input;
    class FRAME,QR,STT,TARGET local;
    class OPAI,QWEN ai;
    class SAFE safety;
    class PRIV,BATT privacy;
    class WS,BR,NAV,TB robot;
    class NOTE note;
