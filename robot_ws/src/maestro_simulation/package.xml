<?xml version="1.0"?>
<package format="3">
  <name>maestro_simulation</name>
  <version>0.1.0</version>
  <description>Gazebo and TurtleBot 4 demo environment for Maestro Agricola.</description>
  <maintainer email="agroturtles@example.invalid">AgroTurtles</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>maestro_robot_bridge</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>turtlebot4_ignition_bringup</exec_depend>
  <exec_depend>turtlebot4_navigation</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
