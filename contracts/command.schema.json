{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maestro-agricola.local/contracts/command.schema.json",
  "title": "MaestroCommand",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "created_at",
    "expires_in_ms",
    "intent",
    "target",
    "confirmed"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "command_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_in_ms": { "type": "integer", "minimum": 1, "maximum": 30000 },
    "intent": { "enum": ["SPRAY"] },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "MAPPED_PLOT" },
        "id": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" }
      }
    },
    "confirmed": { "const": true }
  }
}
